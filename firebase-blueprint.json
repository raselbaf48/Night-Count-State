{
  "entities": {
    "DayStateDoc": {
      "title": "DayStateDoc",
      "description": "Daily Night Count State snapshot for a specific ISO date across all squadrons and units.",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "maxLength": 10,
          "description": "ISO date YYYY-MM-DD"
        },
        "formattedDisplayDate": {
          "type": "string",
          "maxLength": 40,
          "description": "Military display date e.g. 14 Nov 26"
        },
        "preparedBy": {
          "type": "object",
          "description": "Prepared By signatory information"
        },
        "airmen155": {
          "type": "array",
          "description": "Nominal roll airmen list for 155 UASU BAF"
        },
        "unitAirmen": {
          "type": "object",
          "description": "Map of unit name to array of airmen"
        },
        "disposals": {
          "type": "array",
          "description": "List of active disposal records for the day"
        },
        "consolidatedUnits": {
          "type": "array",
          "description": "Consolidated squadron rows"
        },
        "customRemarks": {
          "type": "string",
          "maxLength": 2000,
          "description": "Remarks for 155 UASU BAF"
        },
        "unitRemarks": {
          "type": "object",
          "description": "Map of unit name to remarks string"
        },
        "savedCustomDisposals": {
          "type": "array",
          "description": "Saved custom disposal names"
        },
        "rosterVersion": {
          "type": "integer",
          "description": "Schema migration version"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of user who created the record"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of user who last updated the record"
        }
      },
      "required": [
        "date",
        "formattedDisplayDate",
        "preparedBy",
        "airmen155",
        "disposals",
        "consolidatedUnits",
        "createdAt",
        "createdBy",
        "updatedAt",
        "updatedBy"
      ]
    },
    "SharedSettingsDoc": {
      "title": "SharedSettingsDoc",
      "description": "Shared global Prepared By and custom disposal settings.",
      "type": "object",
      "properties": {
        "preparedBy": {
          "type": "object",
          "description": "Global Prepared By signatory details"
        },
        "savedCustomDisposals": {
          "type": "array",
          "description": "Global list of saved custom disposal names"
        },
        "hiddenQuickEditDisposals": {
          "type": "array",
          "description": "Global list of hidden quick-edit disposal columns"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "preparedBy",
        "savedCustomDisposals",
        "hiddenQuickEditDisposals",
        "createdAt",
        "createdBy",
        "updatedAt",
        "updatedBy"
      ]
    },
    "DateIndexDoc": {
      "title": "DateIndexDoc",
      "description": "Index of ISO dates stored in Firestore.",
      "type": "object",
      "properties": {
        "dates": {
          "type": "array",
          "description": "Sorted list of YYYY-MM-DD strings"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "dates",
        "createdAt",
        "createdBy",
        "updatedAt",
        "updatedBy"
      ]
    }
  },
  "firestore": {
    "/night_count_days/{dateIso}": {
      "schema": {
        "$ref": "#/entities/DayStateDoc"
      },
      "description": "Stores daily Night Count State documents keyed by YYYY-MM-DD."
    },
    "/night_count_meta/settings": {
      "schema": {
        "$ref": "#/entities/SharedSettingsDoc"
      },
      "description": "Stores global Prepared By and custom disposal configuration."
    },
    "/night_count_meta/index": {
      "schema": {
        "$ref": "#/entities/DateIndexDoc"
      },
      "description": "Stores the list of saved date keys in Cloud Firestore."
    }
  }
}
